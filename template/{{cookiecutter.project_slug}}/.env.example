# ── Required ──────────────────────────────────────────────
# One LLM key matching the provider in myg.toml ([agent].model)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Database (auto-filled by `myg db` for neon) ───────────
DATABASE_URL=
# For db=postgres, compose fills this: postgres://postgres:postgres@db:5432/{{ cookiecutter.project_slug.replace('-', '_') }}
# For db=sqlite, leave empty — agent uses ./data/checkpoints.db

# ── CopilotKit (optional: only for CopilotKit cloud/Intelligence) ──
# COPILOTKIT_PUBLIC_API_KEY=

# ── AI Gateway (Kong) ─────────────────────────────────────
{% if cookiecutter.gateway != "off" -%}
# The API key Kong forwards to the provider set in myg.toml (reuse the key above)
LLM_API_KEY=
{% endif -%}
{% if cookiecutter.gateway == "konnect" -%}
KONNECT_TOKEN=
KONNECT_CONTROL_PLANE_ID=
{% endif -%}

# ── myg prompt --backend devin (optional) ─────────────────
# DEVIN_API_KEY=
